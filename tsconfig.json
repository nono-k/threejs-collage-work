{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vite-plugin-glsl/ext"]
  },
  "include": [".astro/types.d.ts", "**/*", "src/types/shader.d.ts"],
  "exclude": ["dist"]
}
